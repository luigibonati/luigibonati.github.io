---
layout: post
---

{% assign t = page.type | default: "Talk" %}
{% assign d = page.dates | default: page.date | date: "%b %d, %Y" %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <div class="card p-3 mb-3">
      <h1 class="post-title mb-2">{{ page.title }}</h1>

      <p class="post-meta">
        {% if t %}<div><strong>Type:</strong> {{ t }}</div>{% endif %}
        {% if d %}<div><strong>Dates:</strong> {{ d }}</div>{% endif %}
        {% if page.location %}<div><strong>Location:</strong> {{ page.location }}</div>{% endif %}
        {% if page.description %}<div class="mt-2"><strong>Description:</strong> {{ page.description }}</div>{% endif %}

        {% if page.website %}
          <div class="mt-2">
            <strong>Website:</strong>
            <a href="{{ page.website }}" target="_blank" rel="noopener noreferrer">{{ page.website }}</a>
          </div>
        </p>
        {% endif %}
      </div>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}
</div>