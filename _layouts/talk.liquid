---
layout: default
---
{% assign t = page.type | default: "Talk" %}
{% if page.dates %}
  {% assign d = page.dates %}
{% else %}
  {% assign d = page.date | date: "%b %d, %Y" %}
{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div class="card talk-card">
      <div class="talk-meta">
        <div class="label">Type</div>
        <div class="value">{{ page.type }}</div>

        <div class="label">Dates</div>
        <div class="value">{{ d }}</div>

        {% if page.organizer %}
          <div class="label">Organizer</div>
          <div class="value">{{ page.organizer }}</div>
        {% endif %}

        {% if page.location %}
          <div class="label">Location</div>
          <div class="value">{{ page.location }}</div>
        {% endif %}

        {% if page.description %}
          <div class="label">Description</div>
          <div class="value">{{ page.description }}</div>
        {% endif %}

        {% if page.website %}
          {% assign pretty_url = page.website
            | remove: "https://"
            | remove: "http://"
            | split: "/" | first
          %}
          <div class="label">Website</div>
          <div class="value">
            <a href="{{ page.website }}"
              class="pretty-link"
              target="_blank"
              rel="noopener noreferrer">
              {{ pretty_url }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>

    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}
</div>