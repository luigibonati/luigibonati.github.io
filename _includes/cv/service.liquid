{% comment %}
  Unified service entry renderer for JSONResume custom section
{% endcomment %}

<div class="row row-cols-1 row-cols-md-2 g-3">
  {% for entry in entries %}
    <div class="col mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-title font-weight-bold mb-2">
            {% if entry.icon %}
              <i class="{{ entry.icon }} mr-2"></i>
            {% endif %}
            {{ entry.name }}
          </h6>

          {% if entry.summary %}
            <p class="card-text">
              {{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}
            </p>
          {% endif %}

          {% if entry.keywords and entry.keywords.size > 0 %}
            <ul class="card-text mb-0">
              {% for keyword in entry.keywords %}
                <li>{{ keyword | markdownify | remove: '<p>' | remove: '</p>' }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>
